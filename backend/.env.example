# Copy to .env and fill in. Never commit .env.
# Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
# Only for projects still on the legacy HS256 JWT secret; leave empty to verify with the project's JWKS
SUPABASE_JWT_SECRET=
# Supabase → Project Settings → Database → Connection string (URI, session pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Staging bucket in a free-tier region (us-central1, us-east1 or us-west1); needs GOOGLE_APPLICATION_CREDENTIALS
GCS_BUCKET=
FRONTEND_ORIGIN=http://localhost:5173
